# Скопируйте этот файл в .env и замените значения. Файл .env в Git не добавляется.
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
LOG_LEVEL=INFO
TOKEN_TTL_SECONDS=3600
PORT=8000

POSTGRES_USER=practicetrack
POSTGRES_PASSWORD=change_me
POSTGRES_DB=practicetrack
DATABASE_URL=postgresql+psycopg2://practicetrack:change_me@db:5432/practicetrack
