              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student{{runId}}@example.kz\",\n  \"password\": \"secret123\",\n  \"full_name\": \"Студент С.\",\n  \"role\": \"student\",\n  \"group\": \"БИС 31с\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 201\", function () { pm.response.to.have.status(201); });"
                ]
              }
            }
